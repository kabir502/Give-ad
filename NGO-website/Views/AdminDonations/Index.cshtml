@model List<Donation>
@{
    ViewData["Title"] = "Donations Ledger";
    Layout = "_AdminLayout";
    var ngos = ViewBag.NGOs as List<NGO> ?? new List<NGO>();
    var causes = ViewBag.Causes as List<Cause> ?? new List<Cause>();
    var search = ViewData["Search"] as string;
    var selectedStatus = ViewData["SelectedStatus"] as DonationStatus?;
    var selectedMethod = ViewData["SelectedMethod"] as PaymentMethodType?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Donations Ledger</h3>
        <p class="text-muted mb-0">Complete audit trail of all direct and online donations across all causes.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="AdminReports" asp-action="Index" class="btn btn-outline-primary shadow-sm">
            <i class="fa-solid fa-file-export me-1"></i> Export Donations
        </a>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-xs fw-bold text-muted">Search Donor / Number / TXN</label>
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="e.g. DON-2026, John, or Email...">
            </div>
            <div class="col-md-2">
                <label class="form-label text-xs fw-bold text-muted">Filter NGO</label>
                <select name="ngoId" class="form-select form-select-sm">
                    <option value="">All NGOs</option>
                    @foreach (var ngo in ngos)
                    {
                        <option value="@ngo.NGOId">@ngo.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-xs fw-bold text-muted">Filter Cause</label>
                <select name="causeId" class="form-select form-select-sm">
                    <option value="">All Causes</option>
                    @foreach (var cause in causes)
                    {
                        <option value="@cause.CauseId">@cause.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-xs fw-bold text-muted">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DonationStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-xs fw-bold text-muted">Payment Method</label>
                <select name="method" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PaymentMethodType>()">
                    <option value="">All Methods</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-magnifying-glass"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Donations Table -->
<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Donation #</th>
                            <th>Date</th>
                            <th>Donor Name & Email</th>
                            <th>NGO & Cause</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@d.DonationId" class="fw-bold text-primary font-monospace">
                                        @d.DonationNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="text-dark d-block">@d.CreatedAt.ToString("dd MMM yyyy")</span>
                                    <span class="text-xs text-muted">@d.CreatedAt.ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@d.DonorName</span>
                                    <span class="text-xs text-muted">@d.DonorEmail</span>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark d-block">@(d.Cause?.Name ?? "General Welfare")</span>
                                    <span class="text-xs text-primary">@(d.NGO?.Name ?? "GIVE-AID")</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">PKR @d.Amount.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@d.PaymentMethod</span>
                                </td>
                                <td>
                                    @if (d.Status == DonationStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (d.Status == DonationStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@d.DonationId" class="btn btn-outline-primary" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Receipt" asp-route-id="@d.DonationId" class="btn btn-outline-success" target="_blank" title="View Official Receipt">
                                            <i class="fa-solid fa-receipt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-hand-holding-dollar fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No donations found</h5>
                <p class="mb-0">No records match the selected filters.</p>
            </div>
        }
    </div>
</div>
