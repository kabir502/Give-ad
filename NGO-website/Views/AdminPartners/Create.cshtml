@model PartnerFormViewModel
@{
    ViewData["Title"] = "Add Partner";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Partners
    </a>
    <h3 class="fw-bold mb-1 text-dark">Add Strategic Partner</h3>
    <p class="text-muted mb-0">Add a corporate donor, CSR sponsor, or foundation logo.</p>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. HBL Foundation" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Corporate Partner, Banking Sponsor, Media Partner" />
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="WebsiteUrl" class="form-label fw-semibold"></label>
                    <input asp-for="WebsiteUrl" class="form-control" placeholder="https://www.partner.com" />
                    <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LogoFile" class="form-label fw-semibold"></label>
                    <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    <small class="text-muted">High resolution transparent PNG logo recommended</small>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief note about partnership scope or CSR sponsorship..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6 d-flex align-items-center pt-2">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                        <label class="form-check-label fs-6 fw-semibold ms-2" asp-for="IsActive">
                            Active (Displayed on public Partners page)
                        </label>
                    </div>
                </div>

                <div class="col-12 pt-3 border-top mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Add Partner
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
