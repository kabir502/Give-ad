@model NGO_website.ViewModels.Home.HelpCentreViewModel
@{
    ViewData["Title"] = "Help & Support Centre";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-sm mb-2">
            <i class="fa-solid fa-life-ring me-1"></i> Transparent Support & Knowledge Base
        </span>
        <h1 class="fw-extrabold text-dark">How Can We Assist You?</h1>
        <p class="text-secondary lead fs-6">Find instant answers to common questions regarding donations, EasyPaisa/JazzCash verification, tax receipts, and NGO partnerships.</p>
    </div>

    <!-- Search & Category Filters -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <form asp-controller="HelpCentre" asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                    <input type="text" name="search" class="form-control form-control-lg" placeholder="Type your question or issue keyword..." value="@Model.SearchQuery" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select form-select-lg">
                    <option value="All">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">Search Help</button>
            </div>
        </form>
    </div>

    <div class="row g-5">
        <!-- FAQs Accordion -->
        <div class="col-lg-8">
            <h4 class="fw-bold text-dark mb-4"><i class="fa-solid fa-circle-question text-primary me-2"></i> Frequently Asked Questions</h4>

            @if (!Model.FAQs.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class="fa-solid fa-circle-info text-secondary display-5 mb-3"></i>
                    <h5 class="fw-bold text-dark">No questions found matching your search</h5>
                    <p class="text-secondary text-sm">Please raise a direct query or contact our 24/7 support team below.</p>
                </div>
            }
            else
            {
                <div class="accordion accordion-flush" id="faqAccordion">
                    @for (int i = 0; i < Model.FAQs.Count; i++)
                    {
                        var faq = Model.FAQs[i];
                        <div class="accordion-item border rounded-3 mb-3 shadow-xs">
                            <h2 class="accordion-header" id="heading_@i">
                                <button class="accordion-button @(i == 0 ? "" : "collapsed") fw-bold text-dark rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse_@i">
                                    <span class="badge bg-primary-subtle text-primary me-2 text-xs">@faq.Category</span>
                                    @faq.Question
                                </button>
                            </h2>
                            <div id="collapse_@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading_@i" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary lh-lg" style="white-space: pre-line;">
                                    @faq.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Right Side: Raise Query Card & Contact Helpline -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-headset fs-3 text-warning"></i>
                    <h5 class="fw-bold m-0">Need Personalized Help?</h5>
                </div>
                <p class="text-light opacity-90 text-sm mb-4">Have an inquiry regarding a payment verification, donation discrepancy, or NGO initiative? Submit a formal query ticket.</p>
                <a asp-controller="Queries" asp-action="Create" class="btn btn-warning fw-bold text-dark rounded-pill py-2">
                    <i class="fa-solid fa-ticket me-1"></i> Raise a Support Query
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-phone text-success me-2"></i> Direct Helplines</h6>
                <div class="text-sm text-secondary mb-2">
                    <strong>Central Secretariat:</strong><br />
                    +92 21 111-GIVEAID (4483-243)
                </div>
                <div class="text-sm text-secondary mb-3">
                    <strong>Email Support:</strong><br />
                    support@giveaid.local
                </div>
                <div class="p-3 bg-light rounded-3 text-xs text-secondary">
                    Operating Hours: Mon - Sat (09:00 AM - 06:00 PM PKT). Emergency donation receipts verified 24/7.
                </div>
            </div>
        </div>
    </div>
</div>
