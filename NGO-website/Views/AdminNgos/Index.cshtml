@model List<NGO>
@{
    ViewData["Title"] = "NGOs Management";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Partner Welfare Organizations</h3>
        <p class="text-muted mb-0">Manage registered welfare foundations, charity partners, and trust organizations.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Register New NGO
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Logo & Organization</th>
                            <th>Contact Info</th>
                            <th>Address</th>
                            <th>Causes & Programmes</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ngo in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(ngo.LogoUrl) ? "https://images.unsplash.com/photo-1532629345422-7515f3d16bb9?w=100" : ngo.LogoUrl)"
                                             alt="@ngo.Name" class="rounded border p-1" style="width: 48px; height: 48px; object-fit: cover;" />
                                        <div>
                                            <a asp-action="Details" asp-route-id="@ngo.NGOId" class="fw-bold text-dark text-decoration-none">@ngo.Name</a>
                                            <span class="text-xs text-muted d-block">Registered: @ngo.CreatedDate.ToString("MMM yyyy")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-dark d-block"><i class="fa-solid fa-envelope text-muted me-1 text-xs"></i>@ngo.Email</span>
                                    <span class="text-xs text-muted"><i class="fa-solid fa-phone text-muted me-1 text-xs"></i>@ngo.Phone</span>
                                </td>
                                <td>
                                    <span class="text-dark text-sm text-truncate d-inline-block" style="max-width: 180px;">@ngo.Address</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary me-1">@(ngo.Causes?.Count ?? 0) Causes</span>
                                    <span class="badge bg-info text-dark">@(ngo.Programmes?.Count ?? 0) Progs</span>
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" asp-route-id="@ngo.NGOId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge border-0 @(ngo.IsActive ? "bg-success" : "bg-secondary")" style="cursor: pointer;">
                                            @(ngo.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@ngo.NGOId" class="btn btn-outline-primary" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@ngo.NGOId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-building-ngo fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No NGOs registered</h5>
                <p class="mb-3">Get started by registering the first partner organization.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Register NGO</a>
            </div>
        }
    </div>
</div>
