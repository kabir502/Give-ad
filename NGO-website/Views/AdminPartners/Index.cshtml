@model List<Partner>
@{
    ViewData["Title"] = "Corporate & Trust Partners";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Corporate & Philanthropic Partners</h3>
        <p class="text-muted mb-0">Manage strategic partners, corporate sponsors, and donor foundations displayed across the site.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add Partner
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Partner & Logo</th>
                            <th>Category</th>
                            <th>Website</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var partner in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@partner.LogoUrl" alt="@partner.Name" class="rounded border p-1 bg-light" style="width: 50px; height: 35px; object-fit: contain;" />
                                        <div>
                                            <span class="fw-bold text-dark d-block">@partner.Name</span>
                                            <span class="text-xs text-muted">Added: @partner.CreatedDate.ToString("MMM yyyy")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@partner.Category</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(partner.WebsiteUrl))
                                    {
                                        <a href="@partner.WebsiteUrl" target="_blank" class="text-primary text-xs text-decoration-none">
                                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Visit Website
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-dark text-xs text-truncate d-inline-block" style="max-width: 250px;">
                                        @(partner.Description ?? "No description provided.")
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" asp-route-id="@partner.PartnerId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge border-0 @(partner.IsActive ? "bg-success" : "bg-secondary")" style="cursor: pointer;">
                                            @(partner.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@partner.PartnerId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@partner.PartnerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this partner?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Remove">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-handshake fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No partners registered</h5>
                <p class="mb-3">Showcase corporate sponsors and partner institutions.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Add Partner</a>
            </div>
        }
    </div>
</div>
