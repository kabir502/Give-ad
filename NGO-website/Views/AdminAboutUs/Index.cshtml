@model List<AboutUsContent>
@{
    ViewData["Title"] = "About Us CMS";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">About Us Content Management</h3>
        <p class="text-muted mb-0">Manage mission, vision, values, leadership, and organization story sections displayed on the public About Us page.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order</th>
                            <th>Section Title & Subtitle</th>
                            <th>Icon / Media</th>
                            <th>Last Updated</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sec in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                        @sec.DisplayOrder
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark d-block">@sec.Title</span>
                                    <span class="text-xs text-muted">@sec.Subtitle</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(sec.IconClass))
                                        {
                                            <i class="@sec.IconClass text-primary fs-5"></i>
                                        }
                                        @if (!string.IsNullOrEmpty(sec.ImageUrl))
                                        {
                                            <img src="@sec.ImageUrl" alt="@sec.Title" class="rounded border" style="width: 45px; height: 30px; object-fit: cover;" />
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="text-dark text-xs">@sec.LastUpdated.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@sec.AboutUsContentId" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Section
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-pen-to-square fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No sections configured</h5>
                <p class="mb-0">Run database seeds to load the default About Us sections.</p>
            </div>
        }
    </div>
</div>
