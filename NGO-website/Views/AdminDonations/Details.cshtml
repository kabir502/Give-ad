@model Donation
@{
    ViewData["Title"] = $"Donation #{Model.DonationNumber}";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Donations Ledger
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Donation Record: @Model.DonationNumber</h3>
            <span class="text-muted">Recorded on @Model.CreatedAt.ToString("dddd, dd MMMM yyyy, hh:mm tt")</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Receipt" asp-route-id="@Model.DonationId" target="_blank" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-receipt me-1"></i> View Official Receipt
            </a>
            @if (Model.Payment != null)
            {
                <a asp-controller="AdminPayments" asp-action="Details" asp-route-id="@Model.Payment.PaymentId" class="btn btn-outline-primary">
                    <i class="fa-solid fa-credit-card me-1"></i> View Payment Record
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Donation Overview -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-info-circle text-primary me-2"></i>Contribution Summary</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Amount Donated</span>
                        <h3 class="fw-bolder text-success my-1">PKR @Model.Amount.ToString("N0")</h3>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Status</span>
                        @if (Model.Status == DonationStatus.Approved)
                        {
                            <span class="badge bg-success fs-6 mt-1">Approved & Counted</span>
                        }
                        else if (Model.Status == DonationStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark fs-6 mt-1">Pending Approval</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 mt-1">Rejected</span>
                        }
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Allocated Cause</span>
                        <span class="fw-bold text-dark fs-6">@(Model.Cause?.Name ?? "General Welfare")</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Partner NGO</span>
                        <span class="fw-semibold text-primary">@(Model.NGO?.Name ?? "GIVE-AID Welfare")</span>
                    </div>
                    @if (Model.Campaign != null)
                    {
                        <div class="col-sm-6">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Campaign</span>
                            <span class="text-dark">@Model.Campaign.Title</span>
                        </div>
                    }
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Payment Method</span>
                        <span class="badge bg-secondary">@Model.PaymentMethod</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DonorNotes))
                    {
                        <div class="col-12">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Donor's Message / Note</span>
                            <div class="p-3 bg-light rounded border text-muted small mt-1">
                                "@Model.DonorNotes"
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                    {
                        <div class="col-12">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Administrative Audit Note</span>
                            <div class="p-3 bg-light rounded border text-dark mt-1">
                                @Model.AdminRemarks
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Approval & Verification Audit Details -->
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-shield-halved text-success me-2"></i>Audit Trail</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Created At</span>
                        <span class="text-dark">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <div class="col-sm-6">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Approved At</span>
                            <span class="text-success fw-semibold">@Model.ApprovedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Approved By</span>
                            <span class="text-dark">@(Model.ApprovedBy?.FullName ?? "Admin User")</span>
                        </div>
                    }
                    @if (Model.RejectedAt.HasValue)
                    {
                        <div class="col-sm-6">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Rejected At</span>
                            <span class="text-danger fw-semibold">@Model.RejectedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-xs text-uppercase text-muted fw-bold d-block">Rejected By</span>
                            <span class="text-dark">@(Model.RejectedBy?.FullName ?? "Admin User")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Donor Profile -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-user text-info me-2"></i>Donor Profile</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 50px; height: 50px;">
                        @Model.DonorName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">@Model.DonorName</h6>
                        @if (Model.User != null)
                        {
                            <span class="badge bg-info text-dark text-xs">Registered Member</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-xs">Guest Donor</span>
                        }
                    </div>
                </div>

                <ul class="list-group list-group-flush border-top">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted text-xs">Email:</span>
                        <span class="fw-medium text-dark">@Model.DonorEmail</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted text-xs">Phone:</span>
                        <span class="fw-medium text-dark">@(Model.DonorPhone ?? "N/A")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted text-xs">Account Status:</span>
                        <span class="fw-medium text-dark">@(Model.UserId != null ? "Registered" : "Guest")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
