@model CauseFormViewModel
@{
    ViewData["Title"] = "Create New Cause";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Causes List
    </a>
    <h3 class="fw-bold mb-1 text-dark">Create New Welfare Cause</h3>
    <p class="text-muted mb-0">Launch a new fundraising target under a verified partner NGO.</p>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NGOId" class="form-label fw-semibold"></label>
                    <select asp-for="NGOId" class="form-select" asp-items="Model.NgoList">
                        <option value="">-- Select Partner NGO --</option>
                    </select>
                    <span asp-validation-for="NGOId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Healthcare, Education, Emergency Relief" />
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Clean Drinking Water for Thar" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TargetAmount" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">PKR</span>
                        <input asp-for="TargetAmount" class="form-control" placeholder="500000" />
                    </div>
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Explain what the cause achieves, budget breakdown, and impact..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    <small class="text-muted">High resolution banner photo (16:9 aspect ratio recommended)</small>
                </div>

                <div class="col-md-6 d-flex align-items-center pt-3">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                        <label class="form-check-label fs-6 fw-semibold ms-2" asp-for="IsActive">
                            Active & accepting donations
                        </label>
                    </div>
                </div>

                <div class="col-12 pt-3 border-top mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Create Cause
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
