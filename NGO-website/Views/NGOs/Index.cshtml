@model IEnumerable<NGO_website.Models.Entities.NGO>
@{
    ViewData["Title"] = "Participating NGOs";
    var search = ViewData["Search"] as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-sm mb-2">
            <i class="fa-solid fa-building-ngo me-1"></i> Verified Humanitarian Organizations
        </span>
        <h1 class="fw-extrabold text-dark">Our Partner NGOs</h1>
        <p class="text-secondary lead fs-6">Meet the trusted welfare foundations and trusts creating sustainable community impact across the nation.</p>
    </div>

    <!-- Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <form asp-controller="NGOs" asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                    <input type="text" name="search" class="form-control form-control-lg" placeholder="Search NGO by name, mission, or city..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">
                    Search NGOs
                </button>
            </div>
        </form>
    </div>

    <!-- NGOs Cards -->
    <div class="row g-4">
        @foreach (var ngo in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@(string.IsNullOrEmpty(ngo.LogoUrl) ? "https://images.unsplash.com/photo-1532629345422-7515f3d16bb9?w=300&auto=format&fit=crop&q=80" : ngo.LogoUrl)" alt="@ngo.Name" class="rounded-circle shadow-xs" style="width: 70px; height: 70px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold text-dark m-0">@ngo.Name</h5>
                            <span class="badge bg-success-subtle text-success border border-success mt-1">Verified Partner</span>
                        </div>
                    </div>

                    <p class="text-secondary text-sm flex-grow-1 mb-3">
                        @(ngo.Description.Length > 140 ? ngo.Description.Substring(0, 137) + "..." : ngo.Description)
                    </p>

                    <div class="border-top pt-3 mb-3 text-xs text-secondary d-flex flex-column gap-1">
                        <div><i class="fa-solid fa-location-dot me-2 text-danger"></i> @ngo.Address</div>
                        <div><i class="fa-solid fa-phone me-2 text-primary"></i> @ngo.Phone</div>
                        <div><i class="fa-solid fa-envelope me-2 text-info"></i> @ngo.Email</div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="NGOs" asp-action="Details" asp-route-id="@ngo.NGOId" class="btn btn-outline-primary btn-sm flex-fill rounded-pill fw-semibold">
                            View Profile
                        </a>
                        <a asp-controller="Donate" asp-action="Index" asp-route-ngoId="@ngo.NGOId" class="btn btn-warning btn-sm flex-fill fw-bold text-dark rounded-pill">
                            <i class="fa-solid fa-heart me-1 text-danger"></i> Donate
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
