@model IEnumerable<NGO_website.Models.Entities.Query>
@{
    ViewData["Title"] = "My Support Queries";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">My Support Queries</h2>
            <p class="text-secondary text-sm m-0">Track all your submitted queries and admin replies.</p>
        </div>
        <a asp-controller="Queries" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Raise New Query
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="fa-solid fa-comments text-secondary display-4 mb-3"></i>
            <h5 class="fw-bold text-dark">You have not submitted any queries yet</h5>
            <p class="text-secondary text-sm">Need help with a payment or programme? Raise a support ticket.</p>
            <div>
                <a asp-controller="Queries" asp-action="Create" class="btn btn-outline-primary rounded-pill">Raise a Query</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket #</th>
                            <th>Category</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Replies</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@q.QueryId</td>
                                <td><span class="badge bg-light text-secondary border">@q.Category</span></td>
                                <td class="fw-semibold text-dark">@q.Subject</td>
                                <td>
                                    @if (q.Status == QueryStatus.Open)
                                    {
                                        <span class="badge bg-warning text-dark">Open</span>
                                    }
                                    else if (q.Status == QueryStatus.InProgress)
                                    {
                                        <span class="badge bg-info text-dark">In Progress</span>
                                    }
                                    else if (q.Status == QueryStatus.Resolved)
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                </td>
                                <td class="text-secondary text-sm">@q.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-secondary rounded-pill">@q.Replies.Count</span></td>
                                <td class="text-end">
                                    <a asp-controller="Queries" asp-action="Details" asp-route-id="@q.QueryId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        View & Reply
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
