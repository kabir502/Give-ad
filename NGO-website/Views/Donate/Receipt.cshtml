@model NGO_website.ViewModels.Donations.DonationReceiptViewModel
@{
    ViewData["Title"] = $"Donation Receipt #{Model.DonationNumber}";
}

<div class="container py-4">
    <!-- Top Action Toolbar (Hidden in print) -->
    <div class="d-flex justify-content-between align-items-center max-w-800 mx-auto mb-3 no-print">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
        <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill shadow-sm px-3">
            <i class="fa-solid fa-print me-1"></i> Print Official Receipt
        </button>
    </div>

    <!-- Official Receipt Printable Document -->
    <div class="receipt-container">
        <!-- Header / Organization Details -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </span>
                    <h3 class="fw-bold m-0 text-primary">GIVE<span class="text-warning">-AID</span></h3>
                </div>
                <p class="text-secondary text-sm m-0">National NGO & Philanthropic Welfare Network</p>
                <p class="text-secondary text-xs m-0">Islamabad Secretariat &bull; Helpline: +92 21 111-4483-243 &bull; www.giveaid.local</p>
            </div>
            <div class="text-end">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6 mb-2">
                    <i class="fa-solid fa-stamp me-1"></i> OFFICIAL RECEIPT
                </span>
                <div class="text-xs text-secondary">Donation ID: <strong class="text-dark">@Model.DonationNumber</strong></div>
                <div class="text-xs text-secondary">Payment Ref: <strong class="text-dark">@Model.PaymentReference</strong></div>
                <div class="text-xs text-secondary">Date: @Model.DonationDate.ToString("dd MMM yyyy, hh:mm tt") UTC</div>
            </div>
        </div>

        <!-- Donor and Recipient Info Box -->
        <div class="row g-4 mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-secondary text-xs text-uppercase fw-bold d-block mb-1">Donor Information</span>
                    <h6 class="fw-bold text-dark m-0">@Model.DonorName</h6>
                    <p class="text-secondary text-sm m-0">Email: @Model.DonorEmail</p>
                    @if (!string.IsNullOrEmpty(Model.DonorPhone))
                    {
                        <p class="text-secondary text-sm m-0">Phone: @Model.DonorPhone</p>
                    }
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-secondary text-xs text-uppercase fw-bold d-block mb-1">Beneficiary Welfare Organization</span>
                    <h6 class="fw-bold text-dark m-0">@Model.NGOName</h6>
                    <p class="text-secondary text-sm m-0">@Model.NGOAddress</p>
                    <p class="text-secondary text-xs m-0">@Model.NGOEmail &bull; @Model.NGOPhone</p>
                </div>
            </div>
        </div>

        <!-- Donation Table Breakdown -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Description / Welfare Cause</th>
                        <th>Payment Method</th>
                        <th>Transaction ID</th>
                        <th class="text-end">Amount (PKR)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>@Model.CauseName</strong>
                            @if (!string.IsNullOrEmpty(Model.CampaignTitle))
                            {
                                <div class="text-muted text-xs">Campaign: @Model.CampaignTitle</div>
                            }
                        </td>
                        <td>
                            @Model.PaymentMethod
                            @if (!string.IsNullOrEmpty(Model.MaskedCardNumber))
                            {
                                <div class="text-xs text-muted">Card: @Model.MaskedCardNumber</div>
                            }
                        </td>
                        <td>
                            <code class="text-dark fw-bold">@Model.TransactionId</code>
                        </td>
                        <td class="text-end fw-bold text-success fs-5">
                            PKR @Model.Amount.ToString("N2")
                        </td>
                    </tr>
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end">Total Verified Amount:</th>
                        <th class="text-end text-success fs-5">PKR @Model.Amount.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Verification & Certification Seal -->
        <div class="row align-items-center pt-3 border-top">
            <div class="col-8">
                <p class="text-secondary text-xs m-0">
                    <i class="fa-solid fa-shield-check text-success me-1"></i>
                    <strong>Tax Exemption Certificate:</strong> This electronic receipt is computer generated and certified by GIVE-AID Central Auditing System. No physical signature is required.
                </p>
                @if (Model.ApprovalDate.HasValue)
                {
                    <p class="text-secondary text-xs m-0 mt-1">Verified & Approved on: <strong>@Model.ApprovalDate.Value.ToString("dd MMMM yyyy, hh:mm tt") UTC</strong></p>
                }
                @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                {
                    <p class="text-secondary text-xs m-0 mt-1">Audit Remarks: <em>@Model.AdminRemarks</em></p>
                }
            </div>
            <div class="col-4 text-end">
                <div class="d-inline-block border border-success p-2 rounded text-center bg-success-subtle">
                    <i class="fa-solid fa-circle-check text-success fs-3"></i>
                    <div class="text-success fw-bold text-xs mt-1">GIVE-AID VERIFIED</div>
                </div>
            </div>
        </div>
    </div>
</div>
