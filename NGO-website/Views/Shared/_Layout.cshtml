<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIVE-AID | NGO & Donation Management System</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Font Awesome 6.6.0 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGDEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["IsLanding"] as bool? == true)
    {
        <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    }
</head>
@{
    var isLanding = ViewData["IsLanding"] as bool? == true;
}
<body class="d-flex flex-column min-vh-100@(isLanding ? " is-landing" : "")">
    <!-- Top Announcement & Contact Bar -->
    <header style="position: relative; z-index: 1040;">
        <div class="top-bar bg-dark text-white py-1 px-3 d-none d-md-block text-sm">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <span><i class="fa-solid fa-heart-pulse text-danger me-1"></i> Give hope today — Empower vulnerable lives across Pakistan</span>
                    <span class="text-secondary">|</span>
                    <span><i class="fa-solid fa-phone me-1 text-primary"></i> 24/7 Helpline: <strong>+92 21 111-4483-243</strong></span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span><i class="fa-solid fa-envelope me-1 text-primary"></i> info&#64;giveaid.local</span>
                    <a asp-controller="HelpCentre" asp-action="Index" class="text-white text-decoration-none hover-underline"><i class="fa-solid fa-circle-question me-1"></i> FAQs & Help</a>
                </div>
            </div>
        </div>

        <!-- Main Navigation Bar -->
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom shadow-sm sticky-top py-2" style="z-index: 1040;">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-primary" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </span>
                    <span>GIVE<span class="text-warning">-AID</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 ms-xl-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1 text-secondary"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-danger px-2" asp-controller="Donate" asp-action="Index">
                                <i class="fa-solid fa-heart me-1"></i>Donate Now
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Causes" asp-action="Index"><i class="fa-solid fa-bullseye me-1 text-secondary"></i>Causes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="NGOs" asp-action="Index"><i class="fa-solid fa-building-ngo me-1 text-secondary"></i>NGOs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Programmes" asp-action="Index"><i class="fa-solid fa-calendar-days me-1 text-secondary"></i>Programmes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Events" asp-action="Index"><i class="fa-solid fa-bullhorn me-1 text-secondary"></i>Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Gallery" asp-action="Index"><i class="fa-solid fa-images me-1 text-secondary"></i>Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Partners" asp-action="Index"><i class="fa-solid fa-handshake me-1 text-secondary"></i>Our Partners</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="AboutUs" asp-action="Index"><i class="fa-solid fa-circle-info me-1 text-secondary"></i>About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="HelpCentre" asp-action="Index"><i class="fa-solid fa-life-ring me-1 text-secondary"></i>Help Centre</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" asp-controller="Contact" asp-action="Index"><i class="fa-solid fa-envelope me-1 text-secondary"></i>Contact Us</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-xl-0">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        <div class="container-fluid px-lg-4">
            <partial name="_NotificationsPartial" />
        </div>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-5 border-top border-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Column 1: Organization Brief -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                        </span>
                        <h4 class="fw-bold m-0 text-white">GIVE<span class="text-warning">-AID</span></h4>
                    </div>
                    <p class="text-secondary text-sm pe-lg-3">
                        GIVE-AID is a trusted non-profit NGO & donation ecosystem connecting generous donors with verified welfare initiatives across Pakistan. 100% transparency with audited multi-channel donations.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle text-white"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle text-white"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle text-white"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle text-white"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle text-white"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold mb-3 text-warning border-start border-3 border-warning ps-2">Navigation</h5>
                    <ul class="list-unstyled text-sm d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Home</a></li>
                        <li><a asp-controller="Donate" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Donate Money</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Welfare Causes</a></li>
                        <li><a asp-controller="NGOs" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Participating NGOs</a></li>
                        <li><a asp-controller="Programmes" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Outreach Programmes</a></li>
                        <li><a asp-controller="Events" asp-action="Index" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-chevron-right me-1 text-xs"></i> Charity Events</a></li>
                    </ul>
                </div>

                <!-- Column 3: Causes & Support -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-warning border-start border-3 border-warning ps-2">Welfare Causes</h5>
                    <ul class="list-unstyled text-sm d-flex flex-column gap-2">
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Children Welfare" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-heart me-1 text-danger text-xs"></i> Children Welfare & Orphan Care</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Education" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-graduation-cap me-1 text-info text-xs"></i> Underprivileged Education</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Disabled Persons" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-wheelchair me-1 text-warning text-xs"></i> Disabled Rehabilitation</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Women Welfare" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-person-dress me-1 text-pink text-xs"></i> Women Empowerment</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Healthcare" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-kit-medical me-1 text-success text-xs"></i> Cancer & Medical Treatment</a></li>
                        <li><a asp-controller="Causes" asp-action="Index" asp-route-category="Food Assistance" class="text-secondary text-decoration-none hover-white"><i class="fa-solid fa-bowl-food me-1 text-secondary text-xs"></i> Daily Ration & Food Aid</a></li>
                    </ul>
                </div>

                <!-- Column 4: Contact & Verification -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-warning border-start border-3 border-warning ps-2">Contact & Transparency</h5>
                    <p class="text-secondary text-sm mb-2"><i class="fa-solid fa-location-dot me-2 text-primary"></i> GIVE-AID National Secretariat, Blue Area, Islamabad</p>
                    <p class="text-secondary text-sm mb-2"><i class="fa-solid fa-phone me-2 text-primary"></i> +92 21 111-GIVEAID (4483-243)</p>
                    <p class="text-secondary text-sm mb-3"><i class="fa-solid fa-envelope me-2 text-primary"></i> support&#64;giveaid.local</p>
                    <div class="p-3 bg-secondary bg-opacity-25 rounded text-sm">
                        <span class="text-success fw-bold"><i class="fa-solid fa-shield-check me-1"></i> Certified Non-Profit</span>
                        <p class="text-secondary m-0 text-xs mt-1">EasyPaisa, JazzCash & Visa/Mastercard payment reconciliation with instant audit receipts.</p>
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-50 my-4" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-secondary text-xs gap-3">
                <div>
                    &copy; @DateTime.UtcNow.Year GIVE-AID &bull; All Rights Reserved. Built with ASP.NET Core MVC 8 & EF Core Code First.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="AboutUs" asp-action="Index" class="text-secondary text-decoration-none hover-white">About Us</a>
                    <a asp-controller="HelpCentre" asp-action="Index" class="text-secondary text-decoration-none hover-white">Help Centre</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none hover-white">Privacy Policy</a>
                    <a asp-controller="Contact" asp-action="Index" class="text-secondary text-decoration-none hover-white">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3.3 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    <!-- jQuery 3.7.1 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    
    <!-- Custom Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewData["IsLanding"] as bool? != true)
    {
        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
        <script src="~/js/theme.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
