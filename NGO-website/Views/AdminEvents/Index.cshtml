@model List<Event>
@{
    ViewData["Title"] = "Events Management";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Events & Seminars</h3>
        <p class="text-muted mb-0">Schedule charity galas, awareness conferences, fundraising dinners, and community meets.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add Event
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Event Details</th>
                            <th>Partner NGO</th>
                            <th>Date & Time</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@evt.ImageUrl" alt="@evt.Title" class="rounded" style="width: 48px; height: 48px; object-fit: cover;" />
                                        <div>
                                            <span class="fw-bold text-dark d-block">@evt.Title</span>
                                            <span class="text-xs text-muted">Created: @evt.CreatedDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">@(evt.NGO?.Name ?? "GIVE-AID")</span>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark d-block">@evt.EventDate.ToString("dd MMM yyyy")</span>
                                    <span class="text-xs text-muted">@evt.EventDate.ToString("hh:mm tt")</span>
                                </td>
                                <td>
                                    <span class="text-dark text-sm"><i class="fa-solid fa-location-dot text-danger me-1"></i>@evt.Location</span>
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" asp-route-id="@evt.EventId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge border-0 @(evt.IsActive ? "bg-success" : "bg-secondary")" style="cursor: pointer;">
                                            @(evt.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-bullhorn fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No events scheduled</h5>
                <p class="mb-3">Host a charity dinner, awareness webinar, or community fundraiser.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Schedule Event</a>
            </div>
        }
    </div>
</div>
