@{
    ViewData["Title"] = "Page Not Found (404)";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <i class="fa-solid fa-map-location-dot text-warning display-3 mb-3"></i>
                <h1 class="display-5 fw-extrabold text-dark">404</h1>
                <h4 class="fw-bold text-dark mb-2">Page Not Found</h4>
                <p class="text-secondary lead fs-6 mb-4">The welfare cause, campaign, or page you are looking for might have been removed or is temporarily unavailable.</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="fa-solid fa-house me-1"></i> Return to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
