@model NGO_website.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden p-4 p-lg-5 bg-white">
                <div class="text-center mb-4">
                    <div class="brand-icon-wrapper bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark m-0">Reset Password</h3>
                    <p class="text-secondary text-sm mt-1">Enter your email and we'll dispatch a secure password reset link.</p>
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="prevent-duplicate-submit">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger text-sm mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-secondary"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger text-xs"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm mb-3">
                        Send Reset Link
                    </button>

                    <div class="text-center text-sm text-secondary">
                        Remember your password? <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">Log In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
