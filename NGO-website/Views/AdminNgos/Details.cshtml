@model NGO
@{
    ViewData["Title"] = $"{Model.Name} - Details";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to NGOs List
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <img src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "https://images.unsplash.com/photo-1532629345422-7515f3d16bb9?w=100" : Model.LogoUrl)"
                 alt="@Model.Name" class="rounded border p-1 bg-white shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" />
            <div>
                <h3 class="fw-bold mb-0 text-dark">@Model.Name</h3>
                <span class="text-muted text-xs">Registered on @Model.CreatedDate.ToString("dd MMMM yyyy") &bull; @(Model.IsActive ? "Active" : "Inactive")</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.NGOId" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Organization
            </a>
        @*     <a asp-controller="NGOs" asp-action="Details" asp-route-id="@Model.NGOId" target="_blank" class="btn btn-outline-secondary shadow-sm">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Public Page
            </a> *@
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Details -->
    <div class="col-lg-8">
        <!-- Overview -->
        <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-circle-info text-primary me-2"></i>About Organization</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-dark leading-relaxed">@Model.Description</p>
                <div class="row g-3 border-top pt-3">
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Official Email</span>
                        <span class="text-dark fw-medium">@Model.Email</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Official Phone</span>
                        <span class="text-dark fw-medium">@Model.Phone</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Website</span>
                        <a href="@Model.Website" target="_blank" class="text-primary text-decoration-none">@(Model.Website ?? "N/A")</a>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-xs text-uppercase text-muted fw-bold d-block">Physical Address</span>
                        <span class="text-dark">@Model.Address</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Causes Managed -->
        <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
            <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-bullseye text-danger me-2"></i>Managed Causes</h5>
                <a asp-controller="AdminCauses" asp-action="Create" class="btn btn-sm btn-outline-danger">+ Add Cause</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Causes != null && Model.Causes.Any())
                {
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Cause Name</th>
                                    <th>Target</th>
                                    <th>Raised</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Causes)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="AdminCauses" asp-action="Details" asp-route-id="@c.CauseId" class="fw-semibold text-dark text-decoration-none">
                                                @c.Name
                                            </a>
                                        </td>
                                        <td>PKR @c.TargetAmount.ToString("N0")</td>
                                        <td class="text-success fw-bold">PKR @c.RaisedAmount.ToString("N0")</td>
                                        <td>
                                            <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="AdminCauses" asp-action="Edit" asp-route-id="@c.CauseId" class="btn btn-xs btn-outline-secondary">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">No causes associated with this organization yet.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Programmes Conducted -->
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-calendar-days text-info me-2"></i>Welfare Programmes</h5>
                <a asp-controller="AdminProgrammes" asp-action="Create" class="btn btn-sm btn-outline-info">+ Add Programme</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Programmes != null && Model.Programmes.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var p in Model.Programmes)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0 fw-bold text-dark">@p.Title</h6>
                                    <span class="text-xs text-muted"><i class="fa-solid fa-calendar me-1"></i>@p.Date.ToString("dd MMM yyyy") &bull; @p.Location</span>
                                </div>
                                <a asp-controller="AdminProgrammes" asp-action="Details" asp-route-id="@p.ProgrammeId" class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">No programmes listed for this organization yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Stats -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-chart-simple text-success me-2"></i>Organization Tally</h5>
            </div>
            <div class="card-body p-4">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total Causes:</span>
                        <span class="fw-bold fs-6">@(Model.Causes?.Count ?? 0)</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total Campaigns:</span>
                        <span class="fw-bold fs-6">@(Model.Campaigns?.Count ?? 0)</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total Programmes:</span>
                        <span class="fw-bold fs-6">@(Model.Programmes?.Count ?? 0)</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Events Held:</span>
                        <span class="fw-bold fs-6">@(Model.Events?.Count ?? 0)</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Total Raised Amount:</span>
                        <span class="fw-bold text-success fs-5">PKR @((Model.Donations?.Where(d => d.Status == DonationStatus.Approved).Sum(d => d.Amount) ?? 0).ToString("N0"))</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
