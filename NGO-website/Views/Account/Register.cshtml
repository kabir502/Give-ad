@model NGO_website.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Free Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden p-4 p-lg-5 bg-white">
                <div class="text-center mb-4">
                    <div class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark m-0">Join GIVE-AID Platform</h3>
                    <p class="text-secondary text-sm mt-1">Create your philanthropic profile to track donations and join NGO initiatives.</p>
                </div>

                <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="prevent-duplicate-submit">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger text-sm mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Farhan Ahmed" />
                            <span asp-validation-for="FullName" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+92 300 0000000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Lahore, Karachi, Islamabad" />
                            <span asp-validation-for="City" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Profession" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Profession" class="form-control" placeholder="e.g. Doctor, Engineer, Teacher" />
                            <span asp-validation-for="Profession" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Address" class="form-control" placeholder="Residential / Street address" />
                            <span asp-validation-for="Address" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Password" class="form-control" placeholder="Min 6 characters" />
                            <span asp-validation-for="Password" class="text-danger text-xs"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger text-xs"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm mt-4 mb-3">
                        Create Account
                    </button>

                    <div class="text-center text-sm text-secondary">
                        Already registered? <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">Log In Here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
