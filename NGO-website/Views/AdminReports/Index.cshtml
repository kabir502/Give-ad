@model ReportResultViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Financial & Welfare Reports</h3>
        <p class="text-muted mb-0">Filter, summarize, generate printable audits, and export donation records to CSV.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="ExportCsv" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReportType" value="@Model.Filter.ReportType" />
            <input type="hidden" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="NGOId" value="@Model.Filter.NGOId" />
            <input type="hidden" name="CauseId" value="@Model.Filter.CauseId" />
            <input type="hidden" name="PaymentMethod" value="@Model.Filter.PaymentMethod" />
            <input type="hidden" name="Status" value="@Model.Filter.Status" />
            <button type="submit" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
            </button>
        </form>

        <a asp-action="Print"
           asp-route-ReportType="@Model.Filter.ReportType"
           asp-route-FromDate="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-ToDate="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-NGOId="@Model.Filter.NGOId"
           asp-route-CauseId="@Model.Filter.CauseId"
           asp-route-PaymentMethod="@Model.Filter.PaymentMethod"
           asp-route-Status="@Model.Filter.Status"
           target="_blank" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-print me-1"></i> Printable Format
        </a>
    </div>
</div>

<!-- Filter Box -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="card-header bg-transparent border-bottom py-3 px-4">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-sliders text-primary me-2"></i>Report Criteria</h6>
    </div>
    <div class="card-body p-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="Filter.ReportType" class="form-label text-xs fw-bold text-muted"></label>
                <select name="ReportType" class="form-select form-select-sm" asp-for="Filter.ReportType">
                    <option value="Donations">Donations Summary</option>
                    <option value="Payments">Payment Transaction Records</option>
                    <option value="CauseWise">Cause Performance</option>
                    <option value="NgoWise">NGO Distribution</option>
                    <option value="Monthly">Monthly Financial Tally</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.NGOId" class="form-label text-xs fw-bold text-muted"></label>
                <select name="NGOId" class="form-select form-select-sm" asp-for="Filter.NGOId" asp-items="Model.Filter.NgoList">
                    <option value="">All NGOs</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.CauseId" class="form-label text-xs fw-bold text-muted"></label>
                <select name="CauseId" class="form-select form-select-sm" asp-for="Filter.CauseId" asp-items="Model.Filter.CauseList">
                    <option value="">All Causes</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.Status" class="form-label text-xs fw-bold text-muted"></label>
                <select name="Status" class="form-select form-select-sm" asp-for="Filter.Status" asp-items="Html.GetEnumSelectList<DonationStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.PaymentMethod" class="form-label text-xs fw-bold text-muted"></label>
                <select name="PaymentMethod" class="form-select form-select-sm" asp-for="Filter.PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethodType>()">
                    <option value="">All Payment Methods</option>
                </select>
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.FromDate" class="form-label text-xs fw-bold text-muted"></label>
                <input name="FromDate" type="date" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3">
                <label asp-for="Filter.ToDate" class="form-label text-xs fw-bold text-muted"></label>
                <input name="ToDate" type="date" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="fa-solid fa-bolt me-1"></i> Generate Report
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Report Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-xs text-uppercase text-muted fw-bold">Total Matching Records</span>
                    <h3 class="fw-bold text-dark my-1">@Model.TotalRecords</h3>
                </div>
                <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                    <i class="fa-solid fa-list-check fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-xs text-uppercase text-muted fw-bold">Total Aggregated Amount</span>
                    <h3 class="fw-bold text-success my-1">PKR @Model.TotalAmount.ToString("N0")</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                    <i class="fa-solid fa-coins fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Report Data Table -->
<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-table text-secondary me-2"></i>Report Results Table</h6>
        <span class="badge bg-light text-dark border">@Model.Rows.Count Rows Generated</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Rows.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Reference / Num</th>
                            <th>Date</th>
                            <th>Donor Name</th>
                            <th>Donor Email</th>
                            <th>NGO</th>
                            <th>Cause</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th class="text-end">Amount (PKR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><span class="fw-bold font-monospace text-primary">@row.ReferenceNumber</span></td>
                                <td><span class="text-dark">@row.Date.ToString("yyyy-MM-dd")</span></td>
                                <td><span class="fw-medium text-dark">@row.DonorName</span></td>
                                <td><span class="text-xs text-muted">@row.DonorEmail</span></td>
                                <td><span class="text-dark">@row.NGOName</span></td>
                                <td><span class="text-dark">@row.CauseName</span></td>
                                <td><span class="badge bg-secondary">@row.PaymentMethod</span></td>
                                <td>
                                    @if (row.Status == "Approved" || row.Status == "Verified")
                                    {
                                        <span class="badge bg-success">@row.Status</span>
                                    }
                                    else if (row.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">@row.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@row.Status</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">@row.Amount.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="8" class="text-end">Total Sum:</td>
                            <td class="text-end text-success fs-6">PKR @Model.TotalAmount.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-chart-simple fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No results found</h5>
                <p class="mb-0">No records matched your specified filters.</p>
            </div>
        }
    </div>
</div>
