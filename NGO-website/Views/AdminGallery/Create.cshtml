@model GalleryFormViewModel
@{
    ViewData["Title"] = "Add Photo to Gallery";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Gallery
    </a>
    <h3 class="fw-bold mb-1 text-dark">Add Photo to Impact Gallery</h3>
    <p class="text-muted mb-0">Upload photographic proof of welfare projects and field operations.</p>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Free Ration Box Distribution in Tharparkar" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Relief, Healthcare, Education, Distribution" />
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="NGOId" class="form-label fw-semibold"></label>
                    <select asp-for="NGOId" class="form-select" asp-items="Model.NgoList">
                        <option value="">-- General / No Specific NGO --</option>
                    </select>
                    <span asp-validation-for="NGOId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ProgrammeId" class="form-label fw-semibold"></label>
                    <select asp-for="ProgrammeId" class="form-select" asp-items="Model.ProgrammeList">
                        <option value="">-- Optional Linked Programme --</option>
                    </select>
                    <span asp-validation-for="ProgrammeId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DateTaken" class="form-label fw-semibold"></label>
                    <input asp-for="DateTaken" type="date" class="form-control" />
                    <span asp-validation-for="DateTaken" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="col-md-6 d-flex align-items-center pt-3">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                        <label class="form-check-label fs-6 fw-semibold ms-2" asp-for="IsActive">
                            Visible on public gallery
                        </label>
                    </div>
                </div>

                <div class="col-12 pt-3 border-top mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Upload to Gallery
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
