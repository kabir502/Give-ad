@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <i class="fa-solid fa-shield-halved text-danger display-3 mb-3"></i>
                <h2 class="fw-extrabold text-dark">Access Denied (403)</h2>
                <p class="text-secondary lead fs-6 mb-4">You do not have the required administrative privileges or permissions to access this page.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Return to Home</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">Switch Account</a>
                </div>
            </div>
        </div>
    </div>
</div>
