@model NGO_website.ViewModels.User.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-5">
    <!-- Welcome Header Strip -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-4 bg-primary text-white">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">Member Portal</span>
                <h2 class="fw-extrabold m-0">Welcome, @Model.UserName!</h2>
                <p class="lead fs-6 opacity-90 m-0 mt-1">Thank you for being part of the GIVE-AID humanitarian network. Here is a summary of your philanthropic journey.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-controller="Donate" asp-action="Index" class="btn btn-warning btn-lg px-4 py-3 fw-bold text-dark rounded-pill shadow">
                    <i class="fa-solid fa-heart me-2 text-danger"></i> Donate Now
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="text-secondary text-xs text-uppercase fw-bold">Total Donated</span>
                <h3 class="fw-extrabold text-success m-0 mt-1">PKR @Model.TotalAmountDonated.ToString("N0")</h3>
                <small class="text-muted text-xs">@Model.ApprovedDonationsCount verified donations</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="text-secondary text-xs text-uppercase fw-bold">Pending Approvals</span>
                <h3 class="fw-extrabold text-warning m-0 mt-1">@Model.PendingDonationsCount</h3>
                <small class="text-muted text-xs">Awaiting receipt verification</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="text-secondary text-xs text-uppercase fw-bold">Volunteering</span>
                <h3 class="fw-extrabold text-info m-0 mt-1">@Model.RegisteredProgrammesCount</h3>
                <small class="text-muted text-xs">Programmes registered</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="text-secondary text-xs text-uppercase fw-bold">Active Queries</span>
                <h3 class="fw-extrabold text-primary m-0 mt-1">@Model.ActiveQueriesCount</h3>
                <small class="text-muted text-xs">Open support tickets</small>
            </div>
        </div>
    </div>

    <!-- Quick Action Shortcuts -->
    <div class="d-flex flex-wrap gap-2 mb-5">
        <a asp-controller="UserDashboard" asp-action="MyDonations" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-hand-holding-dollar me-1"></i> My Donations
        </a>
        <a asp-controller="UserDashboard" asp-action="MyPayments" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-receipt me-1"></i> My Payments
        </a>
        <a asp-controller="UserDashboard" asp-action="MyProgrammes" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-calendar-check me-1"></i> Registered Programmes
        </a>
        <a asp-controller="UserDashboard" asp-action="MyQueries" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-headset me-1"></i> Support Queries
        </a>
        <a asp-controller="UserDashboard" asp-action="InviteFriend" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-user-plus me-1"></i> Invite Friends
        </a>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-gear me-1"></i> Account Settings
        </a>
    </div>

    <div class="row g-5">
        <!-- Recent Donations -->
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark m-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Recent Donations</h4>
                <a asp-controller="UserDashboard" asp-action="MyDonations" class="btn btn-sm btn-outline-primary">View All</a>
            </div>

            @if (!Model.RecentDonations.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <p class="text-secondary m-0">No donations yet. Click below to make your first verified donation.</p>
                    <div class="mt-3">
                        <a asp-controller="Donate" asp-action="Index" class="btn btn-primary btn-sm rounded-pill">Make a Donation</a>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle m-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ref #</th>
                                    <th>Cause / NGO</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="text-end">Receipt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.RecentDonations)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@d.DonationNumber</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@(d.Cause?.Name ?? "Welfare Cause")</div>
                                            <small class="text-secondary">@(d.NGO?.Name ?? "NGO")</small>
                                        </td>
                                        <td class="fw-bold text-success">PKR @d.Amount.ToString("N0")</td>
                                        <td>
                                            @if (d.Status == DonationStatus.Approved)
                                            {
                                                <span class="badge bg-success">Approved</span>
                                            }
                                            else if (d.Status == DonationStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (d.Status == DonationStatus.Approved)
                                            {
                                                <a asp-controller="Donate" asp-action="Receipt" asp-route-id="@d.DonationId" class="btn btn-outline-primary btn-sm rounded-pill">
                                                    <i class="fa-solid fa-receipt"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted text-xs">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Upcoming Programmes Section -->
        <div class="col-lg-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark m-0"><i class="fa-solid fa-calendar-days text-info me-2"></i> Opportunities</h4>
                <a asp-controller="Programmes" asp-action="Index" class="btn btn-sm btn-outline-secondary">Explore</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var prog in Model.UpcomingProgrammes)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                        <span class="badge bg-primary-subtle text-primary align-self-start mb-2">@prog.Date.ToString("ddd, dd MMM yyyy")</span>
                        <h6 class="fw-bold text-dark m-0">@prog.Title</h6>
                        <small class="text-secondary"><i class="fa-solid fa-location-dot text-danger me-1"></i> @prog.Location</small>
                        <div class="mt-2 text-end">
                            <a asp-controller="Programmes" asp-action="Details" asp-route-id="@prog.ProgrammeId" class="btn btn-outline-primary btn-sm rounded-pill px-3">Join & Volunteer</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
