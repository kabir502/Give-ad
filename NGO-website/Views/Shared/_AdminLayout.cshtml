@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | GIVE-AID</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Font Awesome 6.6.0 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Chart.js for Admin Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper d-flex">
        <!-- Sidebar Navigation -->
        <nav id="admin-sidebar" class="bg-dark text-white shadow d-flex flex-column flex-shrink-0 p-3">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary">
                <a asp-controller="Admin" asp-action="Index" class="d-flex align-items-center gap-2 text-white text-decoration-none">
                    <span class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </span>
                    <span class="fs-5 fw-bold">GIVE<span class="text-warning">-AID</span> <span class="badge bg-danger ms-1 text-xs">ADMIN</span></span>
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary d-md-none" id="sidebarCloseBtn">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <ul class="nav nav-pills flex-column mb-auto gap-1 admin-nav-list">
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gauge-high text-info"></i> Dashboard
                    </a>
                </li>
                
                <li class="nav-header text-uppercase text-xs text-secondary mt-2 px-3 fw-bold">Financials</li>
                <li class="nav-item">
                    <a asp-controller="AdminPayments" asp-action="Index" class="nav-link text-white d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-receipt text-warning me-2"></i> Payment Verification</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminDonations" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-hand-holding-dollar text-success"></i> Donations Record
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminReports" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-primary"></i> Reports & Export
                    </a>
                </li>

                <li class="nav-header text-uppercase text-xs text-secondary mt-2 px-3 fw-bold">Welfare Content</li>
                <li class="nav-item">
                    <a asp-controller="AdminNgos" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-building-ngo text-primary"></i> NGOs
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminCauses" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-bullseye text-danger"></i> Causes
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminCampaigns" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-flag-checkered text-warning"></i> Campaigns
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminProgrammes" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-calendar-days text-info"></i> Programmes
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminEvents" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-bullhorn text-success"></i> Events
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminGallery" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-images text-pink"></i> Gallery
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminPartners" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-handshake text-secondary"></i> Partners
                    </a>
                </li>

                <li class="nav-header text-uppercase text-xs text-secondary mt-2 px-3 fw-bold">Support & CMS</li>
                <li class="nav-item">
                    <a asp-controller="AdminQueries" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-headset text-info"></i> User Queries
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminContactMessages" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-envelope-open-text text-warning"></i> Contact Inquiries
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminAboutUs" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-primary"></i> About Us CMS
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminFaqs" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-question text-success"></i> Help Centre FAQs
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminUsers" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-users-gear text-secondary"></i> Users Management
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminSettings" asp-action="Index" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gear text-white"></i> System Settings
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Profile" class="nav-link text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-id-badge text-info"></i> Admin Profile
                    </a>
                </li>
            </ul>

            <hr class="border-secondary opacity-50">
            <div class="d-flex align-items-center justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm w-100" target="_blank">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Public Site
                </a>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="admin-main flex-grow-1 d-flex flex-column min-vh-100 bg-light">
            <!-- Top Navigation Bar -->
            <header class="bg-white border-bottom shadow-sm px-4 py-3 d-flex align-items-center justify-content-between sticky-top">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-md-none" id="sidebarToggleBtn" type="button">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="m-0 fw-bold text-dark">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="AdminPayments" asp-action="Index" asp-route-status="1" class="btn btn-outline-warning btn-sm position-relative">
                        <i class="fa-solid fa-bell"></i> Pending Approvals
                    </a>

                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle fw-semibold" id="adminProfileMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:34px; height:34px;">
                                <i class="fa-solid fa-user-shield"></i>
                            </span>
                            <span>@(currentUser?.FullName ?? "Administrator")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="adminProfileMenu">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Profile"><i class="fa-solid fa-id-badge me-2 text-primary"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="AdminSettings" asp-action="Index"><i class="fa-solid fa-sliders me-2 text-secondary"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger fw-semibold"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <div class="container-fluid p-4 flex-grow-1">
                <partial name="_NotificationsPartial" />
                @RenderBody()
            </div>

            <!-- Admin Footer -->
            <footer class="bg-white border-top py-3 px-4 text-center text-secondary text-sm">
                &copy; @DateTime.UtcNow.Year GIVE-AID Administrator Control Center &bull; Production Environment
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5.3.3 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    <!-- jQuery 3.7.1 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    
    <!-- Admin Sidebar JS -->
    <script>
        $(document).ready(function () {
            $('#sidebarToggleBtn').on('click', function () {
                $('#admin-sidebar').toggleClass('show');
            });
            $('#sidebarCloseBtn').on('click', function () {
                $('#admin-sidebar').removeClass('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
