@model IEnumerable<NGO_website.Models.Entities.Cause>
@{
    ViewData["Title"] = "Welfare Causes";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var ngos = ViewBag.NGOs as List<NGO_website.Models.Entities.NGO> ?? new List<NGO_website.Models.Entities.NGO>();
    var selectedCat = ViewData["SelectedCategory"] as string ?? "All";
    var selectedNgo = ViewData["SelectedNgoId"] as int?;
    var search = ViewData["Search"] as string;
}

<div class="container py-5">
    <!-- Header banner -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-sm mb-2">
            <i class="fa-solid fa-bullseye me-1"></i> Verified Humanitarian Needs
        </span>
        <h1 class="fw-extrabold text-dark">Explore Welfare Causes</h1>
        <p class="text-secondary lead fs-6">Find causes dedicated to children, education, disability support, women, elderly, and medical relief.</p>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
        <form asp-controller="Causes" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label text-sm fw-semibold text-secondary">Search Keyword</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search cause title or details..." value="@search" />
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label text-sm fw-semibold text-secondary">Category</label>
                <select name="category" class="form-select">
                    <option value="All">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(selectedCat == cat)">@cat</option>
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label text-sm fw-semibold text-secondary">Organization</label>
                <select name="ngoId" class="form-select">
                    <option value="">All NGOs</option>
                    @foreach (var n in ngos)
                    {
                        <option value="@n.NGOId" selected="@(selectedNgo == n.NGOId)">@n.Name</option>
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-6">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        Filter
                    </button>
                    <a asp-controller="Causes" asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Causes Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-circle-exclamation text-warning display-4 mb-3"></i>
            <h4 class="fw-bold text-dark">No welfare causes found</h4>
            <p class="text-secondary">Try adjusting your search terms or filter criteria.</p>
            <a asp-controller="Causes" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-2">View All Causes</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cause in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="welfare-card">
                        <div class="position-relative overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(cause.ImageUrl) ? "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&auto=format&fit=crop&q=80" : cause.ImageUrl)" alt="@cause.Name" class="welfare-card-img" />
                            <span class="position-absolute top-0 end-0 m-3 badge bg-primary px-3 py-2 rounded-pill shadow-sm">
                                @cause.Category
                            </span>
                        </div>
                        <div class="welfare-card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-light text-secondary border">
                                    <i class="fa-solid fa-building-ngo me-1 text-primary"></i> @(cause.NGO?.Name ?? "GIVE-AID NGO")
                                </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">
                                <a asp-controller="Causes" asp-action="Details" asp-route-id="@cause.CauseId" class="text-dark text-decoration-none hover-primary">
                                    @cause.Name
                                </a>
                            </h5>
                            <p class="text-secondary text-sm mb-3 flex-grow-1">
                                @(cause.Description.Length > 120 ? cause.Description.Substring(0, 117) + "..." : cause.Description)
                            </p>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between text-xs fw-semibold mb-1">
                                    <span class="text-success">Raised: PKR @cause.RaisedAmount.ToString("N0")</span>
                                    <span class="text-secondary">Goal: PKR @cause.TargetAmount.ToString("N0")</span>
                                </div>
                                <div class="progress custom-progress">
                                    <div class="progress-bar" style="width: @cause.ProgressPercentage%"></div>
                                </div>
                                <div class="text-end text-xs text-secondary mt-1">@cause.ProgressPercentage% Funded</div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="Causes" asp-action="Details" asp-route-id="@cause.CauseId" class="btn btn-outline-secondary btn-sm flex-fill rounded-pill">
                                    Details
                                </a>
                                <a asp-controller="Donate" asp-action="Index" asp-route-causeId="@cause.CauseId" class="btn btn-warning btn-sm flex-fill fw-bold text-dark rounded-pill">
                                    <i class="fa-solid fa-heart me-1 text-danger"></i> Donate
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
