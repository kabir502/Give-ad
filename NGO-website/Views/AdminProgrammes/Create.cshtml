@model ProgrammeFormViewModel
@{
    ViewData["Title"] = "Create Programme";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Programmes
    </a>
    <h3 class="fw-bold mb-1 text-dark">Schedule Welfare Programme</h3>
    <p class="text-muted mb-0">Create an outreach drive, medical camp, or volunteer welfare initiative.</p>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NGOId" class="form-label fw-semibold"></label>
                    <select asp-for="NGOId" class="form-select" asp-items="Model.NgoList">
                        <option value="">-- Select Partner NGO --</option>
                    </select>
                    <span asp-validation-for="NGOId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Free Eye Checkup & Surgery Camp" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Date" class="form-label fw-semibold"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="StartTime" class="form-label fw-semibold"></label>
                    <input asp-for="StartTime" class="form-control" placeholder="09:00 AM" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EndTime" class="form-label fw-semibold"></label>
                    <input asp-for="EndTime" class="form-control" placeholder="05:00 PM" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label fw-semibold"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Community Centre, Sector 5, Karachi" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Capacity" class="form-label fw-semibold"></label>
                    <input asp-for="Capacity" class="form-control" placeholder="Optional capacity limit" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProgrammeStatus>()"></select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Details regarding program agenda, volunteer instructions, registration requirements..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="col-md-6 d-flex align-items-center pt-3">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                        <label class="form-check-label fs-6 fw-semibold ms-2" asp-for="IsActive">
                            Active & visible to public
                        </label>
                    </div>
                </div>

                <div class="col-12 pt-3 border-top mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-check me-1"></i> Save Programme
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
