@model IEnumerable<NGO_website.Models.Entities.GalleryItem>
@{
    ViewData["Title"] = "Media & Programme Gallery";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCat = ViewData["SelectedCategory"] as string ?? "All";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-sm mb-2">
            <i class="fa-solid fa-camera-retro me-1"></i> Visual Stories of Transformation
        </span>
        <h1 class="fw-extrabold text-dark">Impact Photo Gallery</h1>
        <p class="text-secondary lead fs-6">Witness the real-world impact of your generosity across food relief, educational milestones, and healthcare drives.</p>
    </div>

    <!-- Category Pills Filter -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-controller="Gallery" asp-action="Index" asp-route-category="All" class="btn @(selectedCat == "All" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">
            All Photos
        </a>
        @foreach (var cat in categories)
        {
            <a asp-controller="Gallery" asp-action="Index" asp-route-category="@cat" class="btn @(selectedCat == cat ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">
                @cat
            </a>
        }
    </div>

    <!-- Gallery Grid -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="fa-solid fa-images text-secondary display-4 mb-3"></i>
                <h4 class="fw-bold text-dark">No gallery items in this category</h4>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 position-relative group-hover">
                        <img src="@item.ImageUrl" class="w-100 object-fit-cover" style="height: 260px;" alt="@item.Title" />
                        <div class="card-body p-3">
                            <span class="badge bg-primary-subtle text-primary text-xs mb-1">@item.Category</span>
                            <h6 class="fw-bold text-dark mb-1">@item.Title</h6>
                            <div class="d-flex justify-content-between align-items-center text-xs text-secondary mt-2">
                                <span><i class="fa-regular fa-calendar me-1"></i> @item.DateTaken.ToString("dd MMM yyyy")</span>
                                @if (item.NGO != null)
                                {
                                    <span><i class="fa-solid fa-building-ngo me-1"></i> @item.NGO.Name</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
