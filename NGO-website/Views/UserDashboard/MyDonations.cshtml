@model IEnumerable<NGO_website.Models.Entities.Donation>
@{
    ViewData["Title"] = "My Donations";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">My Donations Record</h2>
            <p class="text-secondary text-sm m-0">Full audit log of your contributions with official printable tax receipts.</p>
        </div>
        <a asp-controller="Donate" asp-action="Index" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
            <i class="fa-solid fa-heart me-1 text-danger"></i> Donate Now
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="fa-solid fa-hand-holding-dollar text-secondary display-4 mb-3"></i>
            <h5 class="fw-bold text-dark">No donations recorded yet</h5>
            <p class="text-secondary text-sm">Every small contribution brings hope to vulnerable populations.</p>
            <div>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-primary rounded-pill">Make Your First Donation</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th>Donation ID</th>
                            <th>Welfare Cause</th>
                            <th>Recipient NGO</th>
                            <th>Amount (PKR)</th>
                            <th>Payment Method</th>
                            <th>Transaction ID</th>
                            <th>Donation Date</th>
                            <th>Status</th>
                            <th class="text-end">Official Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.DonationNumber</td>
                                <td>
                                    <div class="fw-semibold text-dark">@(item.Cause?.Name ?? "General Welfare")</div>
                                    @if (item.Campaign != null)
                                    {
                                        <small class="text-muted d-block">Campaign: @item.Campaign.Title</small>
                                    }
                                </td>
                                <td>@(item.NGO?.Name ?? "GIVE-AID NGO")</td>
                                <td class="fw-bold text-success fs-6">PKR @item.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@item.PaymentMethod</span>
                                </td>
                                <td><code>@(item.Payment?.TransactionId ?? "N/A")</code></td>
                                <td class="text-secondary text-sm">@item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    @if (item.Status == DonationStatus.Approved)
                                    {
                                        <span class="badge bg-success px-3 py-2">Approved</span>
                                    }
                                    else if (item.Status == DonationStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">Pending Verification</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2" title="@item.AdminRemarks">Rejected</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Status == DonationStatus.Approved)
                                    {
                                        <a asp-controller="Donate" asp-action="Receipt" asp-route-id="@item.DonationId" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-xs">
                                            <i class="fa-solid fa-file-invoice-dollar me-1"></i> Print Receipt
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-secondary text-xs fst-italic">Pending Admin Review</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
