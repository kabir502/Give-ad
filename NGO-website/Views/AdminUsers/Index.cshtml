@model List<UserManagementViewModel>
@{
    ViewData["Title"] = "Users Management";
    Layout = "_AdminLayout";
    var search = ViewData["Search"] as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Registered Users & Donors</h3>
        <p class="text-muted mb-0">Manage registered member accounts, donor profiles, roles, and access control.</p>
    </div>
</div>

<!-- Search Filter -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label text-xs fw-bold text-muted">Search by Name, Email, or City</label>
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="e.g. John Doe, donor@gmail.com, Karachi...">
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="fa-solid fa-magnifying-glass me-1"></i> Search Users</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Search"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>User Name & Email</th>
                            <th>Role & City</th>
                            <th>Registration Date</th>
                            <th>Donations History</th>
                            <th>Total Donated (PKR)</th>
                            <th>Account Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@user.FullName</span>
                                            <span class="text-xs text-muted">@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-1">
                                        @foreach (var r in user.Roles)
                                        {
                                            <span class="badge @(r == "Admin" ? "bg-danger" : "bg-info text-dark") me-1">@r</span>
                                        }
                                    </div>
                                    <span class="text-xs text-muted">@(user.City ?? "Pakistan") &bull; @(user.Profession ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="text-dark">@user.RegistrationDate.ToString("dd MMM yyyy")</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@user.DonationsCount Donations</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">PKR @user.TotalDonated.ToString("N0")</span>
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge border-0 @(user.IsActive ? "bg-success" : "bg-danger")" style="cursor: pointer;"
                                                onclick="return confirm('Are you sure you want to toggle status for @user.FullName?');">
                                            @(user.IsActive ? "Active" : "Deactivated")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <a href="mailto:@user.Email" class="btn btn-sm btn-outline-primary" title="Email User">
                                        <i class="fa-solid fa-envelope"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-users fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No users found</h5>
                <p class="mb-0">No registered members matched your search query.</p>
            </div>
        }
    </div>
</div>
