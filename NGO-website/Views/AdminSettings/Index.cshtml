@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
    var emailSettings = ViewBag.EmailSettings as NGO_website.Services.Settings.EmailSettings;
    var adminEmail = ViewBag.AdminEmail as string;
    var dbConnection = ViewBag.DbConnection as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">System & Platform Settings</h3>
        <p class="text-muted mb-0">Review SMTP mail server parameters, primary admin account, and database connections.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Email SMTP Configuration -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-envelope text-primary me-2"></i>Email (SMTP) Settings</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-3">
                    Configured in <code>appsettings.json</code> for automated donation receipts, inquiry responses, and verification alerts.
                </p>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">SMTP Server Host:</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(emailSettings?.Host) ? "Local/Dev Emulated" : emailSettings.Host)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Port & SSL:</span>
                        <span class="text-dark">Port @(emailSettings?.Port ?? 587) &bull; SSL: @((emailSettings?.EnableSsl ?? true) ? "Enabled" : "Disabled")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">From Email:</span>
                        <span class="text-dark">@(emailSettings?.FromEmail ?? "noreply@giveaid.local")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Sender Display Name:</span>
                        <span class="text-dark">@(emailSettings?.FromName ?? "GIVE-AID NGO Platform")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Administrative & Database Infrastructure -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
            <div class="card-header bg-transparent border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-server text-success me-2"></i>Infrastructure & DB</h5>
            </div>
            <div class="card-body p-4">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Database Engine:</span>
                        <span class="fw-semibold text-success">@dbConnection</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Default Superadmin:</span>
                        <span class="fw-semibold text-dark">@adminEmail</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Framework & Runtime:</span>
                        <span class="text-dark">.NET 8.0 &bull; ASP.NET Core MVC &bull; EF Core</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Upload Storage Root:</span>
                        <span class="text-dark font-monospace text-xs">/wwwroot/uploads/</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
