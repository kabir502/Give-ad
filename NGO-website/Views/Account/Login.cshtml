@model NGO_website.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Member & Admin Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden p-4 p-lg-5 bg-white">
                <div class="text-center mb-4">
                    <div class="brand-icon-wrapper bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow-sm">
                        <i class="fa-solid fa-right-to-bracket"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark m-0">Welcome Back</h3>
                    <p class="text-secondary text-sm mt-1">Sign in to track donations, view receipts, and manage causes.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="prevent-duplicate-submit">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger text-sm mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-secondary"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger text-xs"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary mb-0"></label>
                            <a asp-controller="Account" asp-action="ForgotPassword" class="text-xs text-primary text-decoration-none">Forgot Password?</a>
                        </div>
                        <div class="input-group mt-1">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-secondary"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger text-xs"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-sm text-secondary"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm mb-3">
                        Sign In
                    </button>

                    <div class="text-center text-sm text-secondary">
                        Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none">Register Now</a>
                    </div>
                </form>

                <!-- Demo Credentials Helper Box -->
                <div class="mt-4 p-3 bg-light rounded-3 border text-xs text-secondary">
                    <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-circle-info text-primary me-1"></i> Demo Credentials:</div>
                    <div><strong>Admin:</strong> admin@giveaid.local / Admin@123456</div>
                    <div><strong>User:</strong> donor@giveaid.local / Donor@123456</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
