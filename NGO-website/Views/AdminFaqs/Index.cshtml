@model List<FAQ>
@{
    ViewData["Title"] = "Help Centre FAQs";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Help Centre & FAQs Management</h3>
        <p class="text-muted mb-0">Manage frequently asked questions, donation guidelines, and tax-exemption info on the Help Centre.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Add FAQ
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order</th>
                            <th>Category</th>
                            <th>Question</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var faq in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary rounded-circle" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center;">
                                        @faq.DisplayOrder
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@faq.Category</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark d-block">@faq.Question</span>
                                    <span class="text-xs text-muted text-truncate d-inline-block" style="max-width: 450px;">
                                        @faq.Answer
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="ToggleStatus" asp-route-id="@faq.FAQId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge border-0 @(faq.IsActive ? "bg-success" : "bg-secondary")" style="cursor: pointer;">
                                            @(faq.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@faq.FAQId" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@faq.FAQId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this FAQ?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-circle-question fa-3x mb-3 text-secondary"></i>
                <h5 class="fw-bold">No FAQs found</h5>
                <p class="mb-3">Add frequently asked questions to assist donors and volunteers.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Add FAQ</a>
            </div>
        }
    </div>
</div>
